<div class="card mb-3">
  <div class="card-header">
    <div class="d-flex w-100 justify-content-between">
      <div>
        <span class="subtitle">
          <%= t('activerecord.models.card_terminal_slot') %>: 
          #<%= @card_terminal_slot.id %>
        </span>
        <h4 class="title"><%= @card_terminal_slot %></h4>
      </div>
      <div role="toolbar" class="pt-3">
        <%= edit_link([@card_terminal_slot.card_terminal, @card_terminal_slot]) %>
        <%= delete_link([@card_terminal_slot.card_terminal, @card_terminal_slot]) %>
      </div>
    </div>
  </div>

  <div class="card-body">
    <table class="table table-sm table-borderless">
    
      <tr>
        <th class="w-10 pe-3"><%= t('attributes.card_terminal')%>:</th>
        <td><%= @card_terminal_slot.card_terminal %></td>
      </tr>

      <tr>
        <th class="w-10 pe-3"><%= t('attributes.slotid')%>:</th>
        <td><%= @card_terminal_slot.slotid %></td>
      </tr>

      <tr>
        <th class="w-10 pe-3"><%= t('attributes.card')%>:</th>
        <td><%= @card_terminal_slot.card %></td>
      </tr>
    </table>
  </div>
</div>

<%= back_link %>
<%= new_link [@card_terminal, CardTerminalSlot] %>
