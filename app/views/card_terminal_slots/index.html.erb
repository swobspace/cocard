<%= render 'shared/turbo-cache-control' %>

<h1><%= t('controller.card_terminal_slots') %></h1>

<div data-controller="datatables">
  <%= content_tag :table, role: :datatable,
        id: "card_terminal_slots_table",
        class: "table table-bordered table-responsive-xl",
        data: {
          'datatables-target': 'datatable',
          order: [[0, 'asc']].to_json
        } do %>
    <thead>
      <tr>
            <th><%= t('attributes.card_terminal') %></th>
            <th class="text-center"><%= t('attributes.slotid') %></th>
            <th><%= t('attributes.card') %></th>
            <th><%= t('attributes.card_type') %></th>
            <th class="nosort text-end"><%= t('cocard.action') %></th>
      </tr>
    </thead>
    <tfoot class="search">
      <tr>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th class="nosearch"></th>
      </tr>
    </tfoot>
    <tbody>
      <% @card_terminal_slots.each do |card_terminal_slot| %>
        <%= content_tag(:tr, id: dom_id(card_terminal_slot), class: dom_class(card_terminal_slot)) do %>
          <td><%= render LinkToComponent.new(item: card_terminal_slot.card_terminal) %></td>
          <td class="text-center"><%= card_terminal_slot.slotid %></td>
          <td><%= render LinkToComponent.new(item: card_terminal_slot.card) %></td>
          <td><%= card_terminal_slot.card&.card_type %></td>
          <td class="text-nowrap text-end">
            <%= show_link [card_terminal_slot.card_terminal, card_terminal_slot] %>
            <%= edit_link [card_terminal_slot.card_terminal, card_terminal_slot] %>
            <%= delete_link [card_terminal_slot.card_terminal, card_terminal_slot] %>
          </td>
        <% end %>
      <% end %>
    </tbody>
  <% end %>
</div>

<br />

<%= back_link %>
<%= new_link [@card_terminal, CardTerminalSlot] %>
