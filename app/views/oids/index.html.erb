<%= render 'shared/turbo-cache-control' %>

<h1><%= t('controller.oids') %></h1>

<div data-controller="datatables">
  <%= content_tag :table, role: :datatable,
        id: "oids_table",
        class: "table table-bordered table-responsive-xl",
        data: {
          'datatables-target': 'datatable',
          order: [[0, 'asc']].to_json
        } do %>
    <thead>
      <tr>
            <th><%= t('attributes.oid') %></th>
            <th><%= t('attributes.name') %></th>
            <th><%= t('attributes.reference') %></th>
            <th class="nosort"><%= t('cocard.action') %></th>
      </tr>
    </thead>
    <tfoot class="search">
      <tr>
            <th></th>
            <th></th>
            <th></th>
            <th class="nosearch"></th>
      </tr>
    </tfoot>
    <tbody>
      <% @oids.each do |oid| %>
        <%= content_tag(:tr, id: dom_id(oid), class: dom_class(oid)) do %>
                <td><%= oid.oid %></td>
                <td><%= oid.name %></td>
                <td><%= oid.reference %></td>
                <td class="text-nowrap">
            <%= show_link oid %>
            <%= edit_link oid %>
            <%= delete_link oid %>
          </td>
        <% end %>
      <% end %>
    </tbody>
  <% end %>
</div>

<br />

<%= back_link %>
<%= new_link Oid %>
