<div class="col">
  <div class="card h-100">
    <div class="card-header">
      <%= entry.displayname %> 
    </div>
    <div class="card-body">
      <table class="table">
        <tbody>
         <tr>
           <th>CN</th>
           <td><%= entry.cn %></td>
         </tr>
         <tr>
           <th>Telematik ID</th>
           <td>
             <%= entry.telematikid %>
           </td>
         </tr>
         <tr>
           <th>Domain ID</th>
           <td><%= entry.domainid %></td>
         </tr>
         <tr>
           <th>Name</th>
           <td><%= entry.sn %></td>
         </tr>
         <tr>
           <th>Vorname</th>
           <td><%= entry.givenname %></td>
         </tr>
         <tr>
           <th>Adresse</th>
           <td><%= entry.postalcode %> <%= entry.l %>, <%= entry.street %></td>
         </tr>
         <tr>
           <th>Organisation</th>
           <td><%= entry.organization %></td>
         </tr>
         <tr>
           <th>Mailadressen</th>
           <td><%= entry.mails.join("<br/>").html_safe %></td>
         </tr>
         <tr>
           <th>Entry Type</th>
           <td><%= entry.entrytype %></td>
         </tr>
         <tr>
           <th>Persönlicher Eintrag</th>
           <td><%= entry.personalentry %></td>
         </tr>
         <tr>
           <th>Spezialisierung</th>
           <td><%= entry.specialization %></td>
         </tr>
         <tr>
           <th>Profession OID</th>
           <td><%= entry.professionoid %> (<%= Oid.where(oid: entry.professionoid).first&.name %>)</td>
         </tr>
         <tr>
           <th>Zuletzt geändert</th>
           <td><%= entry.changedatetime %></td>
         </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
