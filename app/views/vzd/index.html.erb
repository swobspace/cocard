<%= turbo_frame_tag 'vzd' do %>
  <%= render partial: 'shared/flash_alert' %>
  <%# @errors.join("; ") if @errors.present? %>
  <h1 class="mb-3">VZD Suchergebnis</h1>

  <div class="row row-cols-1 row-cols-md-2 g-4">
    <%= render partial: "entry", collection: @entries, as: :entry %>
  </div>

  <%= link_to "Neue Suche", vzd_search_path, class: 'btn btn-secondary mt-3' %>
<% end %>
